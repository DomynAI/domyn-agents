.PHONY: help install serve build

help:
	@echo "Documentation site (Docusaurus):"
	@echo "  install - Install the site dependencies (pnpm)"
	@echo "  serve   - Serve the site on localhost:3000, reloading on save"
	@echo "  build   - Build the static site into build/"

install:
	pnpm install

serve:
	pnpm start

build:
	pnpm build
